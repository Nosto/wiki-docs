%% This is the source for search_api_only_workflow.png
---
config:
  theme: default
---
flowchart TB
start([Start])
create["Create Session
(if none active)"]
fetch["Fetch segments"]
search["Search with segments
& A/B variations"]
store["Store A/B variations
(returned by API)"]
display["Display results"]
track_click["Track search click"]
impression["Track search impression"]
start --> create
create --> fetch
fetch --> search
search --> impression
impression --> display
search --> store
store --> display
display -. on result click .-> track_click
display -.-> start
track_click -.-> start